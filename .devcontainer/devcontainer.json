{
  "name": "Money Printer \u00b7 R notebooks",
  "workspaceMount": "source=${localWorkspaceFolder},target=/project,type=bind",
  "workspaceFolder": "/project",
  "overrideCommand": true,
  "remoteUser": "notebook",
  "updateRemoteUserUID": true,
  "forwardPorts": [
    8000
  ],
  "runArgs": [
    "--env-file",
    "${localWorkspaceFolder}/.env"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-toolsai.jupyter",
        "ms-python.python",
        "quarto.quarto"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/notebook-python/bin/python",
        "jupyter.notebookFileRoot": "${workspaceFolder}",
        "files.exclude": {
          "**/.ipynb_checkpoints": true
        }
      }
    }
  },
  "postStartCommand": "python -m scripts.notebooks.environment",
  "image": "ghcr.io/ckrusemd/money-printer-go-brrr-r@sha256:1fcecffcfdb0135077130e9973fcfdd036c4c8342871e1a380c08366c8f24d6a"
}
